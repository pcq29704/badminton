# Add your LOCAL DEVELOPMENT Supabase values to .env.local when available.
# Leave these empty until then. Do not use production credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only needed for `npm run db:migrate` and `npm run db:seed` (dev database only).
# Supabase dashboard > dev-badminton > Connect > Session pooler > copy the URI and fill in the password.
# The two NEXT_PUBLIC_ values above cannot change the schema, so this one is separate and secret.
# These scripts refuse to run if this points at the production project.
DATABASE_URL=

# Server-only secret used by the player profile API (src/app/api/player/route.ts).
# Supabase dashboard > dev-badminton > Project Settings > API Keys > service_role (secret).
# It bypasses all security rules: never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
